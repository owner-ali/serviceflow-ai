# ServiceFlow AI — environment template
# Copy to .env.local (web) / .env (functions) — never commit real values.

# DEMO MODE — set to true to run the admin web app with zero credentials,
# using seeded in-memory data and a simulated realtime feed (see
# packages/api/src/demoData.ts and mockClient.ts). Every other variable below
# is ignored while this is true. Set to false once you have real Supabase
# credentials filled in. See docs/CREDENTIALS_GUIDE.md for how to get each one.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only, never shipped to client/mobile

# AI (server-side / edge functions only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=
# or
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Payments (server-side only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_SECRET=

# Notifications
FCM_SERVER_KEY=
WHATSAPP_API_TOKEN=
